# Jenkins credential placeholders — copy to jenkins/.env and fill in.
#   cp jenkins/.env.example jenkins/.env
# Everything here is a PLACEHOLDER; the stack still builds with these dummy values.

# --- Jenkins admin login (change for anything beyond local demo) ---
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=admin

# --- dockerhub-credentials (Build & Push stage) ---
# Username: your Docker Hub username.
# Token:    hub.docker.com -> Account Settings -> Personal access tokens -> Generate.
DOCKERHUB_USER=YOUR_DOCKERHUB_USER
DOCKERHUB_TOKEN=PLACEHOLDER_DOCKERHUB_TOKEN

# --- github-token (multibranch scan) ---
# Username: your GitHub username.
# Token:    GitHub -> Developer settings -> fine-grained PAT (repo read).
GITHUB_USER=YOUR_GITHUB_USER
GITHUB_TOKEN=PLACEHOLDER_GITHUB_TOKEN

# --- kubeconfig (Deploy stage) ---
# Base64 of your kubeconfig AFTER `minikube start`:
#   macOS:  base64 -i ~/.kube/config      (copy the one-line output here)
#   Linux:  base64 -w0 ~/.kube/config
# Default below is base64("PLACEHOLDER") so JCasC loads cleanly until you set a real one.
KUBECONFIG_B64=UExBQ0VIT0xERVI=
