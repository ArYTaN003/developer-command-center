# ==========================================================================
# Developer Command Center — Environment Configuration (example)
# Copy to .env and fill in real values:   cp .env.example .env
# Every value below has a safe local default in docker-compose.yml, so the
# stack runs end-to-end with placeholders. Replace the PLACEHOLDER_* values
# with real credentials when you want live GitHub / Claude connectivity.
# ==========================================================================

# -------- Claude / Anthropic API (keep placeholders; fill manually) --------
# When the key is left as a placeholder, services fall back to a local stub
# response so the pipeline is still fully demonstrable offline.
# Default base URL is the public Anthropic API. Override only if you use an
# Anthropic-compatible proxy (some proxies authenticate via Authorization: Bearer).
ANTHROPIC_API_KEY=PLACEHOLDER_ANTHROPIC_API_KEY
ANTHROPIC_BASE_URL=https://api.anthropic.com
CLAUDE_MODEL=claude-haiku-4-5

# -------- GitHub API (keep placeholder; fill manually) ---------------------
# Fine-grained PAT with: contents:read, pull_requests:read, issues:read.
# Leave as placeholder to run locally via the /webhook + /simulate endpoints.
GITHUB_TOKEN=PLACEHOLDER_GITHUB_TOKEN
GITHUB_API_URL=https://api.github.com
# Comma-separated "owner/repo" list the poller watches (when a real token is set)
GITHUB_REPOS=octocat/hello-world
GITHUB_POLL_ENABLED=false
GITHUB_POLL_INTERVAL_MINUTES=10

# -------- PostgreSQL: github-db --------------------------------------------
GITHUB_DB_HOST=github-db
GITHUB_DB_PORT=5432
GITHUB_DB_NAME=github
GITHUB_DB_USER=github
GITHUB_DB_PASSWORD=PLACEHOLDER_GITHUB_DB_PASSWORD

# -------- PostgreSQL: reviews-db --------------------------------------------
REVIEWS_DB_HOST=reviews-db
REVIEWS_DB_PORT=5432
REVIEWS_DB_NAME=reviews
REVIEWS_DB_USER=reviews
REVIEWS_DB_PASSWORD=PLACEHOLDER_REVIEWS_DB_PASSWORD

# -------- Redis -------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# -------- Qdrant (vector store) --------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=github_context

# -------- RabbitMQ ----------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_EVENTS_EXCHANGE=github.events
RABBITMQ_NOTIFICATIONS_EXCHANGE=notifications

# -------- Inter-service URLs (Kubernetes DNS / Compose service names) ------
RAG_CONTEXT_URL=http://rag-context-service:8000
AI_REVIEW_URL=http://ai-review-service:8000

# -------- Embedding mode: "hash" (local, zero-download) or "st" (sentence-transformers)
EMBEDDING_MODE=hash
EMBEDDING_DIM=256

# -------- Circuit breaker tuning (kept aggressive for the demo) ------------
CLAUDE_BREAKER_FAIL_MAX=2
CLAUDE_BREAKER_RESET_TIMEOUT=10
GITHUB_BREAKER_FAIL_MAX=5
GITHUB_BREAKER_RESET_TIMEOUT=30
RAG_BREAKER_FAIL_MAX=3
RAG_BREAKER_RESET_TIMEOUT=15
